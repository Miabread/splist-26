{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["node"],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "rootDirs": [".", "src"],
        "outDir": "./dist",
        "declaration": true
    },
    "exclude": ["node_modules"],
    "include": ["src/**/*"]
}
